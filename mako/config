anchor=top-right
margin=12
padding=12
width=360
height=120

font=JetBrainsMono Nerd Font 10
text-color=#dfe3dc

background-color=#0c120ff2
border-color=#354039
border-size=1
border-radius=2

outer-margin=4
default-timeout=5000
ignore-timeout=0

markup=1
format=<b>%s</b>\n%b
icons=1
max-icon-size=32
icon-location=left

layer=overlay
sort=-time
group-by=app-name
actions=1

invisible=0

[urgency=low]
background-color=#0c120ff2
border-color=#354039
text-color=#9eae91
default-timeout=3000

[urgency=normal]
background-color=#0c120ff2
border-color=#354039
text-color=#dfe3dc
default-timeout=5000

[urgency=high]
background-color=#151b17
border-color=#d66f6f
text-color=#ffffff
default-timeout=0
